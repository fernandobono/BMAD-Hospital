# Copiá este archivo a .env (que no se versiona) y cambiá las tres claves.
# Sin .env, docker compose se corta antes de crear los contenedores.
POSTGRES_PASSWORD=cambiar-esta-clave-postgres
TURNOS_OWNER_PASSWORD=cambiar-esta-clave-owner
TURNOS_APP_PASSWORD=cambiar-esta-clave-app
# Usuario y clave del servidor de correo (story 1.4). Vacías con Mailpit, que no pide nada;
# en producción van las del servidor SMTP real.
SMTP_USUARIO=
SMTP_CLAVE=
# Primer administrador del personal (story 2.1). Sólo se usa si la base no tiene ningún usuario.
# La contraseña: 10 caracteres o más, con mayúscula, minúscula y número. Vacía, la app arranca sin
# administrador y lo avisa en el registro. Si el nombre queda vacío, se usa "Administración".
ADMIN_INICIAL_USUARIO=admin
ADMIN_INICIAL_CONTRASENA=
ADMIN_INICIAL_NOMBRE=
