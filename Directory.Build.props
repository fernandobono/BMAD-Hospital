<Project>
  <!-- Lo que comparten los 7 proyectos (contrato técnico). Los de src/ suman
       TreatWarningsAsErrors en src/Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
