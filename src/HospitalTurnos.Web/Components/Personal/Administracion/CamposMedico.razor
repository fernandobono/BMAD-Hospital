@* Los campos de A1 (story 3.2), comunes al alta y a la ficha, con el estándar de la guía (story 3.3, AC 67): en el
   orden en que se piensa al médico (identidad, clasificación, configuración), con ayuda donde hay formato o un
   porqué. La especialidad es un select con búsqueda; el usuario del sistema es opcional. *@
<CampoDeFormulario TValor="string" Etiqueta="Nombre" Id="nombre" Obligatorio="true" @bind-Valor="Input.Nombre" />
<CampoDeFormulario TValor="string" Etiqueta="Apellido" Id="apellido" Obligatorio="true" @bind-Valor="Input.Apellido" />
<CampoDeFormulario TValor="string" Etiqueta="Matrícula" Id="matricula" Obligatorio="true" Ayuda="Ejemplo: MP 1234"
                   @bind-Valor="Input.Matricula" />
<CampoDeFormulario TValor="long?" Etiqueta="Especialidad" Id="especialidad" Obligatorio="true" TextoVacio="Elegí una especialidad"
                   Opciones="OpcionesDeEspecialidad" @bind-Valor="Input.EspecialidadId" />
<CampoDeFormulario TValor="Guid?" Etiqueta="Usuario del sistema" Id="usuario" TextoVacio="Sin usuario" Opciones="OpcionesDeUsuario"
                   Ayuda="Vinculalo para que el médico pueda ver y gestionar su agenda." @bind-Valor="Input.UsuarioPersonalId" />

@code {
    [Parameter, EditorRequired]
    public FormularioMedico Input { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<EspecialidadResumen> Especialidades { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<OpcionUsuarioMedico> Usuarios { get; set; } = [];

    private IReadOnlyList<SelectConBusqueda.Opcion> OpcionesDeEspecialidad =>
    [
        .. Especialidades.Select(e => new SelectConBusqueda.Opcion(e.Id.ToString(), e.Activa ? e.Nombre : $"{e.Nombre} (desactivada)")),
    ];

    private IReadOnlyList<SelectConBusqueda.Opcion> OpcionesDeUsuario =>
        [.. Usuarios.Select(u => new SelectConBusqueda.Opcion(u.Id.ToString(), $"{u.NombreCompleto} ({u.Usuario})"))];
}
