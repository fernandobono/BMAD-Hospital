@page "/personal/admin/medicos/nuevo"
@layout LayoutPersonal
@attribute [Authorize(Roles = HospitalTurnos.Dominio.Personal.Roles.Administrador)]
@using HospitalTurnos.Web.Errores
@inject IGestionMedicos Gestion
@inject ICatalogoEspecialidades Catalogo
@inject NavigationManager Navegacion

@* A1, el alta (UX §7, story 3.2), renderizado estático. La página atrapa SÓLO las excepciones del dominio y
   muestra su mensaje en un cartel con el código del manejador global; lo inesperado sigue a ese manejador. *@
<PageTitle>Nuevo médico · Las Acacias</PageTitle>

<h1>Nuevo médico</h1>

<p><a href="@RutasPersonal.Medicos">Volver a Médicos</a></p>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (especialidades.Count == 0)
{
    <p>No hay especialidades activas. Creá una en Especialidades antes de dar de alta un médico.</p>
    <p><a href="@RutasPersonal.Especialidades">Ir a Especialidades</a></p>
}
@if (especialidades.Count > 0 || esEnvio)
{
    @* Con un envío se dibuja igual: un POST armado sin especialidades activas cae en el AC 9 (cartel 400). *@
    <EditForm Model="Input" method="post" OnValidSubmit="GuardarAsync" FormName="medico" style="max-width: 32rem;">
        <DataAnnotationsValidator />
        <CamposMedico Input="Input!" Especialidades="especialidades" Usuarios="usuarios" />
        <button type="submit" class="btn btn-primary" style="background-color: #1F5FA8;">Dar de alta</button>
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "medico")]
    private FormularioMedico? Input { get; set; }

    private IReadOnlyList<EspecialidadResumen> especialidades = [];
    private IReadOnlyList<OpcionUsuarioMedico> usuarios = [];
    private string? error;
    private bool esEnvio;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        esEnvio = HttpMethods.IsPost(HttpContext.Request.Method);
        // En SSR la página se arma entera en cada pedido (GET y POST): las listas se cargan siempre.
        especialidades = await Catalogo.ListarActivasAsync(HttpContext.RequestAborted);
        usuarios = await Gestion.UsuariosParaVincularAsync(null, HttpContext.RequestAborted);
    }

    private async Task GuardarAsync()
    {
        long id;
        try
        {
            id = await Gestion.CrearAsync(Input!.ADatos(), ActorDeSesion.Desde(HttpContext.User), HttpContext.RequestAborted);
        }
        catch (Exception e) when (ManejadorGlobalDeErrores.EsEsperable(e))   // sólo las del dominio
        {
            // UX §8: el cartel arriba del formulario con la regla; el código es el del manejador (409/400/404/403).
            // FijarEstadoEnPagina difiere el 404: con Blazor .NET 10 una página SSR en 404 sale sin cuerpo.
            ManejadorGlobalDeErrores.FijarEstadoEnPagina(HttpContext, e);
            error = e.Message;
            return;
        }
        Navegacion.NavigateTo($"{RutasPersonal.FichaMedico(id)}?resultado=alta");   // fuera del try (SSR)
    }
}
